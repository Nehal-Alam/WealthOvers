# ==============================================================================
# WealthOvers Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# Do NOT commit .env.local to source control.
# ==============================================================================

# Supabase Public API Credentials (Client-side accessible)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Private Keys (Serverless runtime only - NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Database Connection String (Supavisor Transaction Pooler on port 6543)
# Used by Drizzle ORM and migrations in serverless environments
DATABASE_URL="postgres://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
